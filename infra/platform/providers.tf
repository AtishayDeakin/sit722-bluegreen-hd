# Both providers are pinned to one kubeconfig context so Terraform can only
# ever change the intended cluster (Docker Desktop by default).

provider "kubernetes" {
  config_path    = var.kubeconfig_path
  config_context = var.kube_context
}

provider "helm" {
  kubernetes = {
    config_path    = var.kubeconfig_path
    config_context = var.kube_context
  }
}
